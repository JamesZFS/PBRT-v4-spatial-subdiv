MakeNamedMaterial "Light"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0 0 0 ]

AttributeBegin
    AreaLightSource "diffuse"
        "rgb L" [ 17 12 4 ]
    NamedMaterial "Light"
    AttributeBegin
        Translate 0 1.98 0
        Rotate 180 1 0 0
        Translate 0 -1.98 0
        Translate 0 0.09 0.05
        Shape "trianglemesh"
            "point2 uv" [ 0 0 1 0 1 1 0 1 
                ]
            "normal N" [ 8.74228e-8 1 -1.86006e-7 
                         8.74228e-8 1 -1.86006e-7 
                         8.74228e-8 1 -1.86006e-7 
                         8.74228e-8 1 -1.86006e-7 ]
            "point3 P" [ -0.24 1.98 -0.22 
                          0.23 1.98 -0.22 
                          0.23 1.98  0.16 
                         -0.24 1.98  0.16 ]
            "integer indices" [ 0 1 2 0 2 3 ]
    AttributeEnd
AttributeEnd
